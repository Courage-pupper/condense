#!/usr/bin/env python3
# Fake libsecret `secret-tool` for tests: one secret in $HOME/.fake_keyring; argv is logged to prove the secret is not in it.
import os, sys
home = os.environ["HOME"]
store, log = os.path.join(home, ".fake_keyring"), os.path.join(home, ".fake_secret_tool_argv")
args = sys.argv[1:]
open(log, "a").write(" ".join(args) + "\n")
attrs = [a for a in args[1:] if not a.startswith("--")]
if attrs != ["service", "Condense", "account", "huggingface-token"]:
    sys.exit(3)
if args[0] == "store":
    open(store, "w").write(sys.stdin.read()); sys.exit(0)
if args[0] == "lookup":
    if os.path.exists(store):
        sys.stdout.write(open(store).read()); sys.exit(0)
    sys.exit(1)
if args[0] == "clear":
    if os.path.exists(store): os.remove(store)
    sys.exit(0)
sys.exit(2)

#!/usr/bin/env python3
# Fake HandBrakeCLI for the Linux scenario: lists CPU encoders, "encodes" by copying the input, logs its argv.
import os, shutil, sys
args = sys.argv[1:]
if "--help" in args:
    print("   svt_av1\n   x265\n   x265_10bit\n   x264"); sys.exit(0)
open(os.path.join(os.environ["HOME"], ".fake_handbrake_args"), "w").write("\n".join(args))
src, dst = args[args.index("-i") + 1], args[args.index("-o") + 1]
for p in (30, 70, 100):
    print(f"Encoding: task 1 of 1, {p:.2f} % (50.0 fps, avg 48.0 fps, ETA 00h00m01s)", flush=True)
shutil.copyfile(src, dst)
